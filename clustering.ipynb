
# ==========================================
# K-MEANS, SPECTRAL AND HIERARCHICAL CLUSTERING
# Silhouette Score Comparison
# ==========================================

import numpy as np
import pandas as pd

from sklearn.cluster import (
    KMeans,
    SpectralClustering,
    AgglomerativeClustering
)

from sklearn.preprocessing import StandardScaler
from sklearn.metrics import silhouette_score


# 1. Dataset

data = {
    'Hours_Studied': [
        1, 2, 1.5, 2.5, 3,
        5, 6, 5.5, 6.5, 7,
        8, 9, 8.5, 9.5, 10
    ],

    'Marks': [
        30, 35, 28, 40, 38,
        55, 60, 58, 65, 62,
        85, 90, 88, 95, 92
    ]
}

df = pd.DataFrame(data)


# 2. Select features

X = df[['Hours_Studied', 'Marks']]


# 3. Standardize the data

scaler = StandardScaler()

X_scaled = scaler.fit_transform(X)


# 4. Define the clustering models

models = {

    "K-Means": KMeans(
        n_clusters=3,
        random_state=42,
        n_init=10
    ),

    "Spectral": SpectralClustering(
        n_clusters=3,
        affinity='nearest_neighbors',
        n_neighbors=5,
        random_state=42
    ),

    "Hierarchical": AgglomerativeClustering(
        n_clusters=3
    )
}


# 5. Train models and calculate Silhouette Score

results = {}

labels_results = {}

for name, model in models.items():

    # Apply clustering
    labels = model.fit_predict(X_scaled)

    # Calculate silhouette score
    score = silhouette_score(X_scaled, labels)

    results[name] = score

    labels_results[name] = labels


# 6. Display results

print("\n========== CLUSTERING SCORE COMPARISON ==========")

print(f"{'Model':<18} {'Silhouette Score':<20}")

for name, score in results.items():

    print(f"{name:<18} {score:<20.4f}")


# 7. Find the best clustering model

best_model = max(results, key=results.get)

print("\nBest Model based on Silhouette Score:", best_model)


# 8. Display cluster assignments

print("\n========== CLUSTER ASSIGNMENTS ==========")

for name, labels in labels_results.items():

    print(f"\n{name}:")

    for i, label in enumerate(labels):

        print(
            f"Hours Studied: {df.iloc[i]['Hours_Studied']}, "
            f"Marks: {df.iloc[i]['Marks']}, "
            f"Cluster: {label}"
        )
